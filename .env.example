# Copy to .env and fill in values. Never commit .env.

# NVIDIA NIM (packages/ai)
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_NIM_MODEL=

# AI provider selection (nvidia | fake)
GOFLUENT_AI_PROVIDER=nvidia

# Speech (packages/speech) — audio is opt-in
GOFLUENT_SPEECH_ENABLED=false
KOKORO_MODEL_DIR=
KOKORO_DEFAULT_VOICE=af_heart
GOFLUENT_SPEECH_DEFAULT_SPEED=1.0

# Online TTS fallback (Microsoft Edge Read Aloud via msedge-tts) — opt-in,
# sends learner text off-device, unlike the on-device Kokoro default.
GOFLUENT_SPEECH_ONLINE_FALLBACK=false
EDGE_TTS_DEFAULT_VOICE=en-US-AriaNeural

# ASR / Speak Mode microphone conversation (packages/speech) — opt-in;
# typed conversation always works without this. Uses NVIDIA_API_KEY above.
GOFLUENT_ASR_ENABLED=false
NVIDIA_ASR_BASE_URL=https://ai.api.nvidia.com/v1/speech
NVIDIA_ASR_MODEL=

# Learning defaults
GOFLUENT_DAILY_MINUTES=20
GOFLUENT_NEW_ITEMS_PER_SESSION=8

# Optional: override the local data directory used for gofluent.db, cache/, audio/, logs/
GOFLUENT_DATA_DIR=
