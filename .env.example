# Copy to .env.local and fill in from Supabase > Project Settings > API.
# The anon key is safe in the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: load audio from a bucket/CDN instead of /public (no trailing path needed).
# Files must live at <base>/audio/<slug>.mp3, e.g. https://cdn.example.com
NEXT_PUBLIC_AUDIO_BASE_URL=

# Only needed to run scripts/upload-audio.mjs. From Project Settings > API > service_role.
# This bypasses Row Level Security: keep it out of the client bundle and out of git.
SUPABASE_SERVICE_ROLE_KEY=

E2E_EMAIL=
E2E_PASSWORD=
