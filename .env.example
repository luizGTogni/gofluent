# Copy to .env and fill in values. Never commit .env.

# NVIDIA NIM (packages/ai)
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_NIM_MODEL=

# AI provider selection (nvidia | fake)
GOFLUENT_AI_PROVIDER=nvidia

# Learning defaults
GOFLUENT_DAILY_MINUTES=20
GOFLUENT_NEW_ITEMS_PER_SESSION=8

# Optional: override the local data directory used for gofluent.db, cache/, audio/, logs/
GOFLUENT_DATA_DIR=
